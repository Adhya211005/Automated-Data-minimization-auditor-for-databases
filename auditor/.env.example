# Copy to auditor/.env (gitignored). Connection profile for the TARGET
# database the auditor scans. This role must be read-only - see
# migrations/001_create_readonly_role.sql.
AUDIT_DB_DIALECT=postgresql
AUDIT_DB_HOST=localhost
AUDIT_DB_PORT=5432
AUDIT_DB_USER=dma_auditor_ro
AUDIT_DB_PASSWORD=dma_auditor_ro_pw
AUDIT_DB_NAME=dma_auditor
AUDIT_DB_SCHEMA=public
